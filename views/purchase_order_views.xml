<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_view_form_inherit_saas_api" model="ir.ui.view">
        <field name="name">purchase.order.form.saas.api</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,sent,purchase,fully_billed,done</attribute>
            </xpath>
        </field>
    </record>
</odoo>
